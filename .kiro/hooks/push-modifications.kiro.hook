{
  "name": "Push e Abrir Pull Request",
  "description": "Verifica se há alterações pendentes e exibe mensagem de proibição se houver. Realiza o push da branch atual e abre um Pull Request vinculado à issue no GitHub usando o script open_pr.ps1.",
  "version": "1.0.0",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Execute o scripts/open_pr.sh"
  },
  "enabled": true,
  "workspaceFolderName": "mini-projeto-MockAi",
  "shortName": "push-modifications"
}