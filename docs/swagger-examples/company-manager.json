    "components": {
        "schemas": {
            "OwnerDTO": {
                "required": [
                    "birthDate",
                    "cpf",
                    "email",
                    "id",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Identificador do responsável",
                        "format": "uuid",
                        "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "name": {
                        "type": "string",
                        "description": "Nome do responsável",
                        "example": "João Silva"
                    },
                    "email": {
                        "type": "string",
                        "description": "Email do responsável",
                        "example": "joao.silva@email.com"
                    },
                    "phone": {
                        "pattern": "\\d{11}",
                        "type": "string",
                        "description": "Telefone do responsável (11 dígitos, incluindo DDD)",
                        "example": "11987654321"
                    },
                    "cpf": {
                        "pattern": "\\d{11}",
                        "type": "string",
                        "description": "CPF do responsável (11 dígitos)",
                        "example": "12345678901"
                    },
                    "birthDate": {
                        "type": "string",
                        "description": "Data de nascimento do responsável",
                        "format": "date",
                        "example": "1990-01-01"
                    }
                },
                "description": "Armazena dados completos do responsável pela empresa"
            },
            "ErrorCategoryDTO": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "Código de erro específico para identificar o tipo de falha"
                    },
                    "message": {
                        "type": "string",
                        "description": "Mensagem de erro detalhada explicando a falha"
                    },
                    "timestamp": {
                        "type": "string",
                        "description": "Timestamp indicando quando o erro ocorreu",
                        "format": "date-time"
                    }
                },
                "description": "Armazena dados de erro para respostas de falha da API"
            },
            "CompanyDTO": {
                "required": [
                    "businessSegment",
                    "cnpj",
                    "email",
                    "foundationDate",
                    "id",
                    "municipality",
                    "name",
                    "owner"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Identificador da empresa",
                        "format": "uuid",
                        "example": "123e4567-e89b-12d3-a456-426614174000"
                    },
                    "name": {
                        "type": "string",
                        "description": "Nome da empresa",
                        "example": "Tech Solutions Ltda."
                    },
                    "owner": {
                        "$ref": "#/components/schemas/OwnerDTO"
                    },
                    "municipality": {
                        "type": "string",
                        "description": "Município em que a empresa está localizada",
                        "example": "São Paulo"
                    },
                    "cnpj": {
                        "pattern": "\\d{14}",
                        "type": "string",
                        "description": "CNPJ da empresa (14 dígitos)",
                        "example": "12345678000199"
                    },
                    "businessSegment": {
                        "type": "string",
                        "description": "Segmento de atuação da empresa",
                        "example": "TECHNOLOGY",
                        "enum": [
                            "TECHNOLOGY",
                            "COMMERCE",
                            "INDUSTRY",
                            "SERVICES",
                            "AGRIBUSINESS"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "description": "Email de contato da empresa",
                        "example": "suporte@tech.com"
                    },
                    "phone": {
                        "pattern": "\\d{11}",
                        "type": "string",
                        "description": "Telefone de contato da empresa (11 dígitos, incluindo DDD)",
                        "example": "11987654321"
                    },
                    "foundationDate": {
                        "type": "string",
                        "description": "Data de fundação da empresa",
                        "format": "date",
                        "example": "2000-01-01"
                    },
                    "isActive": {
                        "type": "boolean",
                        "description": "Indica o status da empresa (ativa ou inativa)",
                        "example": true
                    }
                },
                "description": "Armazena dados completos de uma empresa"
            },
            "CreateOwnerDTO": {
                "required": [
                    "birthDate",
                    "cpf",
                    "email",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nome do responsável",
                        "example": "João Silva"
                    },
                    "email": {
                        "type": "string",
                        "description": "Email do responsável",
                        "example": "joao.silva@email.com"
                    },
                    "phone": {
                        "pattern": "\\d{11}",
                        "type": "string",
                        "description": "Telefone do responsável (11 dígitos, incluindo DDD)",
                        "example": "11987654321"
                    },
                    "cpf": {
                        "pattern": "\\d{11}",
                        "type": "string",
                        "description": "CPF do responsável (11 dígitos)",
                        "example": "12345678901"
                    },
                    "birthDate": {
                        "type": "string",
                        "description": "Data de nascimento do responsável",
                        "format": "date",
                        "example": "1990-01-01"
                    }
                },
                "description": "Armazena dados necessários para criar um novo responsável pela empresa"
            },
            "PaginationDTO": {
                "type": "object",
                "properties": {
                    "page": {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Número da página a ser retornada (0 para a primeira página)",
                        "format": "int32"
                    },
                    "size": {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Número de itens por página a ser retornado",
                        "format": "int32"
                    }
                },
                "description": "Armazena dados de paginação para consultas paginadas"
            },
            "PageDTOOwnerDTO": {
                "required": [
                    "contents"
                ],
                "type": "object",
                "properties": {
                    "size": {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Número de itens por página a ser retornado",
                        "format": "int32"
                    },
                    "page": {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Número da página a ser retornada (0 para a primeira página)",
                        "format": "int32"
                    },
                    "totalElements": {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Número total de elementos disponíveis para a consulta, considerando todas as páginas",
                        "format": "int64"
                    },
                    "totalPages": {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Número total de páginas disponíveis para a consulta, considerando o tamanho da página e o total de elementos",
                        "format": "int32"
                    },
                    "contents": {
                        "type": "array",
                        "description": "Coleção contendo os elementos para a página solicitada",
                        "items": {
                            "$ref": "#/components/schemas/OwnerDTO"
                        }
                    }
                },
                "description": "Armazena dados de uma página de resultados para consultas paginadas"
            },
            "CreateCompanyDTO": {
                "required": [
                    "businessSegment",
                    "cnpj",
                    "email",
                    "foundationDate",
                    "municipality",
                    "name",
                    "owner"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nome da empresa",
                        "example": "Tech Solutions Ltda."
                    },
                    "owner": {
                        "$ref": "#/components/schemas/OwnerDTO"
                    },
                    "municipality": {
                        "type": "string",
                        "description": "Município em que a empresa está localizada",
                        "example": "São Paulo"
                    },
                    "cnpj": {
                        "pattern": "\\d{14}",
                        "type": "string",
                        "description": "CNPJ da empresa (14 dígitos)",
                        "example": "12345678000199"
                    },
                    "businessSegment": {
                        "type": "string",
                        "description": "Segmento de atuação da empresa",
                        "example": "TECHNOLOGY",
                        "enum": [
                            "TECHNOLOGY",
                            "COMMERCE",
                            "INDUSTRY",
                            "SERVICES",
                            "AGRIBUSINESS"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "description": "Email de contato da empresa",
                        "example": "suporte@tech.com"
