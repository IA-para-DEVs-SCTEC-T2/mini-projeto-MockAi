        "/owner": {
            "get": {
                "tags": [
                    "Responsáveis"
                ],
                "summary": "Buscar todos os recursos (paginado) - Versão GET",
                "description": "Recupera uma lista paginada de todos os recursos usando requisição GET com parâmetros de paginação",
                "operationId": "findAll",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número da página (iniciado em 0)",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        },
                        "example": 0
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Número de itens por página",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        },
                        "example": 10
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Parâmetros de paginação inválidos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorCategoryDTO"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Recursos recuperados com sucesso",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageDTOOwnerDTO"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Responsáveis"
                ],
                "summary": "Atualizar um recurso existente",
                "description": "Atualiza um recurso existente com os dados fornecidos",
                "operationId": "merge",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OwnerDTO"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "404": {
                        "description": "Recurso não encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorCategoryDTO"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Recurso já existe (conflito)",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorCategoryDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados de entrada inválidos",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorCategoryDTO"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Recurso atualizado com sucesso",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/OwnerDTO"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Responsáveis"
                ],
                "summary": "Criar um novo recurso",
                "description": "Cria um novo recurso com os dados fornecidos",
                "operationId": "create",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateOwnerDTO"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Recurso criado com sucesso",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/OwnerDTO"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Recurso já existe (conflito)",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorCategoryDTO"
